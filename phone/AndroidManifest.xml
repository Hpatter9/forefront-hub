<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.forefront.keystone" android:versionCode="5" android:versionName="1.3.0">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Only on Android 8 and 9: to save a photo taken with the camera before it is sent to the job. -->
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
  <queries>
    <intent><action android:name="android.speech.action.RECOGNIZE_SPEECH" /></intent>
    <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
    <intent><action android:name="android.intent.action.GET_CONTENT" /><data android:mimeType="image/*" /></intent>
  </queries>
  <!-- Plain http is used once, on your own Wi-Fi, to fetch the (encrypted) setup from Keystone on the laptop. -->
  <application android:label="Keystone" android:icon="@drawable/icon" android:allowBackup="false" android:usesCleartextTraffic="true" android:theme="@style/App">
    <activity android:name=".MainActivity" android:exported="true" android:windowSoftInputMode="adjustResize" android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
